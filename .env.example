# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development          # development | staging | production
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json              # json | pretty

# ── Database ──────────────────────────────────────────────────────────────────
# asyncpg driver required
DATABASE_URL=postgresql+asyncpg://llmx:changeme@localhost:5432/llmx

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Security ──────────────────────────────────────────────────────────────────
# Shared secret sent by the extension as X-API-Key header.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
INGESTION_API_KEY=replace-with-a-real-secret

# ── Ingestion limits ──────────────────────────────────────────────────────────
MAX_HTML_SIZE_BYTES=5242880   # 5 MB
MAX_SELECTED_TEXT_BYTES=65536 # 64 KB

# ── Test overrides (used only by pytest) ──────────────────────────────────────
# TEST_DATABASE_URL=postgresql+asyncpg://llmx:changeme@localhost:5432/llmx_test
